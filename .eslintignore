**/main.js
**/staticBundle.js
docs/generatedComponentApiDocs.js
packages/react-native/flow/
packages/react-native/sdks/
packages/react-native/ReactAndroid/build
packages/react-native/ReactAndroid/hermes-engine/build/
# CMake writes its dependency timestamps as `compiler_depend.ts`, which ESLint
# picks up as TypeScript and fails to parse.
private/react-native-fantom/build/

# Gradle writes an HTML test report with a bundled report.js into every module's
# build directory. It is generated, has no Flow annotation, and made `yarn lint`
# fail for anyone who had run the Gradle plugin's tests — which is to say, after
# touching the plugin at all.
packages/gradle-plugin/*/build/
packages/react-native/Libraries/Renderer/*
packages/react-native/Libraries/vendor/**/*
# Vendored Astryx sources, kept byte-identical to upstream on purpose. They
# carry their own eslint-disable comments for rules this repo does not define,
# which ESLint reports as errors — and "fixing" them would mean editing files
# whose whole value is being unmodified.
packages/rn-tester/js/astryx/vendor/**/*
# Astryx's themes as `astryx theme build` writes them, generated and vendored
# as they are
packages/rn-tester/js/astryx/vendor-themes/*/built/**/*
# Astryx's page templates, kept identical to upstream (`scripts/sync-templates.js
# --check`), and the web build the app's timings compare against
packages/astryx-demo/templates/**/*
packages/astryx-demo/web/
node_modules/
packages/*/node_modules
packages/*/dist
packages/*/types_generated
packages/debugger-frontend/dist/**/*
packages/react-native-codegen/lib
private/react-native-codegen-typescript-test/lib/**/*
**/Pods/*
**/*.macos.js
**/*.windows.js
**/__fixtures__/**
