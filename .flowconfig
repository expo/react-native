[ignore]
; The local expo checkout, linked into node_modules for the DOM-elements PoC
; (expo-modules-core, expo-image). Nothing here imports their JS — the catalog
; names native components, not packages — and following the symlinks would pull
; the entire pnpm store of that repo into the crawl.
.*/Developer/expo/.*
; The same packages through their node_modules symlinks: flow does not
; canonicalize before matching, so both spellings need ignoring.
<PROJECT_ROOT>/node_modules/expo/.*
<PROJECT_ROOT>/node_modules/expo-image/.*
<PROJECT_ROOT>/node_modules/expo-modules-core/.*
<PROJECT_ROOT>/node_modules/expo-modules-autolinking/.*
; The symlink ENTRIES themselves, not only what is under them, plus `@expo`
; which the four patterns above do not cover — `@expo` is a different path from
; `expo*`.
<PROJECT_ROOT>/node_modules/expo
<PROJECT_ROOT>/node_modules/expo-image
<PROJECT_ROOT>/node_modules/expo-modules-core
<PROJECT_ROOT>/node_modules/expo-modules-autolinking
<PROJECT_ROOT>/node_modules/@expo/.*
; Any pnpm store, anywhere. `~/Developer/expo` is a pnpm workspace and
; `.pnpm` is a symlink FARM — 2,231 package directories that link to one
; another, so a traversal that follows them does not terminate. Measured with
; `find -L`: 28.7M "files" reachable under `node_modules/expo`, 36.5M under
; `node_modules/expo-image`, and the walk had still not finished after ten
; minutes. A general guard rather than a path-specific one, because the next
; linked pnpm workspace will not be at this path.
.*/\.pnpm/.*

; THE SAME GENERATED TREES, REACHED A SECOND TIME THROUGH A WORKSPACE SYMLINK.
;
; This monorepo links ~20 of its own packages into `node_modules/@react-native/*`,
; so every path ignored above as `<PROJECT_ROOT>/private/...` or
; `<PROJECT_ROOT>/packages/...` has a second spelling that none of those
; patterns match. Measured: 2,012 files under
; `node_modules/@react-native/fantom/.out` and 6,908 under its `build` — the
; former being exactly the Metro bundle cache the note below calls "gigabytes of
; generated multi-megabyte bundles… what turns a cold check from minutes into
; hours". Ignored once, parsed anyway.
;
; The BUILD OUTPUT only, not the packages themselves: those are real sources and
; Flow resolves imports through these very paths. The same trick as the
; `node_modules/react-native` entry below, applied to the packages that entry
; does not cover.
<PROJECT_ROOT>/node_modules/@react-native/.*/\.out/.*
<PROJECT_ROOT>/node_modules/@react-native/.*/build/.*

; react-native itself, through its node_modules symlink. Every `react-native`
; import is already redirected to <PROJECT_ROOT>/packages/react-native by the
; module.name_mapper rules below, so the symlinked spelling resolves nothing
; extra — it only offers Flow a second path to the same ~6,500 files.
<PROJECT_ROOT>/node_modules/react-native/.*

; The Fantom runner's per-test Metro bundle cache: gigabytes of generated
; multi-megabyte bundles that grow with every suite run. Parsing them is what
; turns a cold check from minutes into hours.
<PROJECT_ROOT>/private/react-native-fantom/.out/.*

; Ignore build cache folder
<PROJECT_ROOT>/packages/react-native/sdks/.*

; Native build output. Gradle and CocoaPods write continuously into these
; while an Android or iOS build runs, and Flow watches the project root — so a
; build daemon left alive in the background retriggers the check forever. That
; presents as a server stuck "initializing" with memory sawtoothing while the
; CPU stays pegged, which reads like a hang and is not one.
<PROJECT_ROOT>/packages/react-native/ReactAndroid/build/.*
<PROJECT_ROOT>/packages/react-native/ReactAndroid/\.cxx/.*
; The same thing, for the build outputs the list above missed. Together these
; are ~10,500 files and 3.2GB that Flow was crawling and, worse, being woken by:
; they are rewritten by every Android build and every Fantom tester rebuild,
; which is precisely the "background process retriggers the check forever"
; failure described above.
;
; They are not empty of things Flow parses, which is why leaving them in was not
; free — `module.file_ext=.json` means every `compile_commands.json`,
; `prefab.json` and `annotationProcessors.json` in there was being read, plus a
; generated `InternalBytecode.js`. Nothing imports from any of them.
; Babel's on-disk cache — 21MB of generated JSON across three of these, and
; every one of them is a file Flow PARSES (`module.file_ext=.json`). Worse, they
; are rewritten by every jest run: `.babel.7.28.0.test.json` alone is 6.6MB and
; its mtime moves whenever the suite runs, so a check racing a test run is woken
; by a multi-megabyte edit it then has to re-read.
.*/node_modules/\.cache/.*
<PROJECT_ROOT>/private/react-native-fantom/build/.*
<PROJECT_ROOT>/packages/react-native/ReactAndroid/hermes-engine/build/.*
<PROJECT_ROOT>/packages/gradle-plugin/.*/build/.*
<PROJECT_ROOT>/packages/rn-tester/android/.*/build/.*
<PROJECT_ROOT>/packages/rn-tester/Pods/.*
<PROJECT_ROOT>/packages/react-native-popup-menu-android/android/build/.*
.*/\.gradle/.*
.*/\.cxx/.*

; Lint tooling in node_modules. Nothing here is imported by anything Flow
; checks, and it dominates the crawl: eslint-plugin-react and
; eslint-plugin-import are ~2,500 files each, and the `es-abstract` shim family
; (`array.prototype.*`, `string.prototype.*`, `reflect.getprototypeof`, …) adds
; ~2,300 more apiece. Excluding them takes the parse set from ~24,000 files to
; ~6,000.
.*/node_modules/eslint.*
.*/node_modules/@eslint/.*
.*/node_modules/es-abstract/.*
.*/node_modules/es-to-primitive/.*
.*/node_modules/[a-z]+\.prototype\..*
.*/node_modules/arraybuffer\.prototype\..*
.*/node_modules/reflect\.getprototypeof/.*

; Ignore fb_internal modules
<PROJECT_ROOT>/packages/react-native/src/fb_internal/.*

; Ignore the codegen e2e tests
<PROJECT_ROOT>/packages/react-native-codegen/e2e/__test_fixtures__/modules/NativeEnumTurboModule.js

; Ignore "BUCK" generated dirs
<PROJECT_ROOT>/\.buckd/

; Ignore git's own metadata. A branch name ending in ".json" — upstream has
; one, `@chrfalch/prebuild-fix-missing-script-file-in-package.json` — becomes a
; reflog file of that name under .git/logs/refs, which Flow then tries to parse
; as JSON and fails the whole check on. Fetching a branch should not be able to
; break typechecking.
<PROJECT_ROOT>/\.git/.*

; Ignore other platform suffixes
.*\.macos\.js$
.*\.windows\.js$

.*/node_modules/resolve/test/resolver/malformed_package_json/package\.json$

; Checked-in build output
<PROJECT_ROOT>/packages/debugger-frontend/dist/

; Generated build output
<PROJECT_ROOT>/packages/.*/dist

; helloworld
<PROJECT_ROOT>/private/helloworld/ios/Pods/

; Ignore rn-tester Pods
<PROJECT_ROOT>/packages/rn-tester/Pods/

[untyped]
.*/node_modules/@react-native-community/cli/.*/.*

[include]

[declarations]
.*/node_modules/.*

[libs]
flow-typed/
packages/react-native/flow/

[options]
emoji=true

; Use watchman rather than Flow's built-in crawler. On a repo this size the
; built-in watcher is what makes a cold start pathological here.
file_watcher=watchman

format.bracket_spacing=false

module.file_ext=.js
module.file_ext=.json

experimental.multi_platform=true
experimental.multi_platform.extensions=.ios
experimental.multi_platform.extensions=.android

munge_underscores=true

module.name_mapper='^react-native$' -> '<PROJECT_ROOT>/packages/react-native/index.js'
module.name_mapper='^react-native/react-private-interface$' -> '<PROJECT_ROOT>/packages/react-native/src/react-private-interface.js'
module.name_mapper='^react-native/setup-env$' -> '<PROJECT_ROOT>/packages/react-native/src/setup-env.js'
module.name_mapper='^react-native/\(.*\)$' -> '<PROJECT_ROOT>/packages/react-native/\1'
module.name_mapper='^@react-native/dev-middleware$' -> '<PROJECT_ROOT>/packages/dev-middleware'
module.name_mapper='^@?[./a-zA-Z0-9$_-]+\.\(bmp\|gif\|jpg\|jpeg\|png\|psd\|svg\|webp\|m4v\|mov\|mp4\|mpeg\|mpg\|webm\|aac\|aiff\|caf\|m4a\|mp3\|wav\|html\|pdf\|xml\|ktx\|heic\|heif\)$' -> '<PROJECT_ROOT>/packages/react-native/Libraries/Image/RelativeImageStub'

module.system.haste.module_ref_prefix=m#

react.runtime=automatic

ban_spread_key_props=true

[lints]
sketchy-null-number=warn
sketchy-null-mixed=warn
sketchy-number=warn
untyped-type-import=warn
nonstrict-import=warn
deprecated-type=error
unsafe-getters-setters=warn
unnecessary-invariant=warn
unused-promise=error

[strict]
deprecated-type
nonstrict-import
sketchy-null
unclear-type
unsafe-getters-setters
untyped-import
untyped-type-import

[version]
^0.322.0
